{
  "name": "smhi-mcp-server",
  "version": "1.2.0",
  "description": "MCP server for SMHI (Swedish Meteorological and Hydrological Institute) weather forecast data",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "smhi-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleAndi/smhi-mcp-server.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "smhi",
    "weather",
    "sweden",
    "forecast",
    "snow1g"
  ]
}
